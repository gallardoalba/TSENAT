\section{Statistical Methods}{

\describe{
  \item{\strong{Diversity Metrics}}{
    Tsallis Entropy: \eqn{H_q = \frac{1}{q-1} \left(1 - \sum_{i} p_i^q\right)} 
    Hill Numbers: \eqn{D_q = \left(\sum_{i} p_i^q\right)^{\frac{1}{1-q}}}
  }
  \item{\strong{Divergence}}{
    Tsallis Divergence: \eqn{D_q(p||r) = \frac{1}{q-1}\left(1 - \sum_{i} p_i^q r_i^{1-q}\right)}
    Kullback-Leibler distance (q=1 limit): \eqn{D_{KL}(p||r) = \sum_i p_i \log(p_i/r_i)}
  }
  \item{\strong{Resampling}}{
    Jackknife leave-one-out, block bootstrap (paired data), and percentile/BCA confidence 
    intervals with accuracy enhancement for skewed distributions.
  }
  \item{\strong{Interaction Testing}}{
    LMM: \eqn{H_{g,c} = \beta_0 + \beta_g(\text{gene}) + \beta_c(\text{condition}) + 
    \beta_{gc}(\text{gene} \times \text{condition}) + \epsilon}
    With random effects for paired/nested designs.
  }
}
}

\section{Key Features}{

\itemize{
  \item \strong{Multiscale q-parameter sweep}: Detects biological signals at different 
    probability scales without multiple testing correction for q-values.
  \item \strong{Robust resampling}: Leave-one-out jackknife + block bootstrap handles 
    paired designs and maintains correlation structure.
  \item \strong{Multiple method backends}: nlme, MASS, geepack, or rank-based (Scheirer-Ray-Hare, 
    sign test) for model flexibility.
  \item \strong{FDR-corrected testing}: Benjamini-Hochberg adjustment across genes and q-values.
  \item \strong{Production-grade visualization}: ggplot2-based plots optimized for 
    large gene sets and publication quality.
  \item \strong{Reproducibility tracking}: Automatic logging of function calls, parameters, 
    timestamps, and package version for audit trails.
  \item \strong{S4 object-oriented design}: Unified \code{\link{TSENATAnalysis}} container 
    ensures metadata integrity throughout the pipeline.
}
}

