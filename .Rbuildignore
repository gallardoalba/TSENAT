^docs/
^dist/
^build/
^_pkgdown.yml$
^\.codecov.yml$
^\.covrignore$
^\.git$
^\.git/
^\.Rproj.user$
^\.Rhistory$
^\.Ruserdata$
^\.vscode$
^\.DS_Store$
^TSENAT_.*\.tar\.gz$
^\.\.Rcheck$
^\.github$
^\.circleci$

# Ignore vignette intermediate files
^vignettes/.*\.Rhistory$
^vignettes/.*\.utf8$
^vignette/*pdf
^vignette/*html

# Do not include development helper tools in built package
^tools/
^database/
^output/

# Exclude compiler coverage files from src/
^src/.*\.gcda$
^src/.*\.gcno$

# Exclude pkgdown custom CSS assets from built package
^inst/pkgdown/
