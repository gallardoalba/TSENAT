# Makevars for Windows (use LTO optimization on Windows)
# Coverage-aware configuration (portable with BSD make)

# Check if running coverage analysis
COVERAGE_FLAGS = $(if $(R_COVERAGE),-O0 -fprofile-arcs -ftest-coverage,-O3 -flto)
COVERAGE_LIBS = $(if $(R_COVERAGE),-fprofile-arcs -ftest-coverage,)

# Release build: use LTO optimization; coverage: no optimization, no LTO
PKG_CXXFLAGS = $(COVERAGE_FLAGS) $(if $(R_COVERAGE),,$(SHLIB_OPENMP_CXXFLAGS))
PKG_LIBS = $(if $(R_COVERAGE),,$(SHLIB_OPENMP_CXXFLAGS)) $(LAPACK_LIBS) $(BLAS_LIBS) $(COVERAGE_LIBS)
