# Makevars for Rcpp/Armadillo compilation
# 
# This configuration enables:
# - Armadillo optimizations (vectorization)
# - OpenMP parallelization (if available, except during coverage)
# - C++11 standard and beyond
# - Aggressive optimization flags (except during coverage)

# Check if running coverage analysis
# When R_COVERAGE=1 (set by covr), disable optimization and parallelization
# to avoid corruption of coverage data (.gcno/.gcda files)

# Use $(if ...) for portable conditional assignment
# Portable alternative to ifdef R_COVERAGE ... else ... endif
# During coverage, disable _FORTIFY_SOURCE (incompatible with -O0)
CXX11FLAGS = $(if $(R_COVERAGE),-O0 -fPIC -fprofile-arcs -ftest-coverage -U_FORTIFY_SOURCE,-O3 -fPIC)

# Coverage build: no parallelization; Release build: with OpenMP
PKG_CXXFLAGS = $(if $(R_COVERAGE),,$(SHLIB_OPENMP_CXXFLAGS))

# Add coverage flags to libs if in coverage mode
COVERAGE_FLAGS = $(if $(R_COVERAGE),-fprofile-arcs -ftest-coverage,)
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(COVERAGE_FLAGS)
